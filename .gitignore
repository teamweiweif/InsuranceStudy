projects/**/output/**/*state_week_cells.csv

# Allow project-level metadata and compact final outputs.
!projects/
!projects/*/
!projects/*/data_metadata/
!projects/*/data_metadata/**

# Preserve existing zero-premium metadata/processed audit files after reorg.
!projects/aca_zero_premium_turnover/data/
!projects/aca_zero_premium_turnover/data/metadata/
!projects/aca_zero_premium_turnover/data/metadata/**
!projects/aca_zero_premium_turnover/data/processed/
