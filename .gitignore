.Rhistory
.RData
.Rproj.user/

# Bulky diagnostic cell-level outputs kept locally, not in git
outputs/**/*state_month_cells.csv
outputs/**/*state_week_cells.csv
outputs/**/unwinding_state_month_transition_cells.csv
outputs/**/second_round_unwinding_state_month_cells.csv
